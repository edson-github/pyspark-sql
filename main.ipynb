    "# Import required functions\n",
    "from pyspark.sql.types import StructType, StructField, StringType, IntegerType\n",
    "\n",
    "# Define the schema for the country table\n",
    "country_schema = StructType([\n",
    "    StructField(\"id\", IntegerType(), False),  # False means not nullable\n",
    "    StructField(\"country\", StringType(), False)\n",
    "])\n",
    "\n",
    "# Create sample data for countries\n",
    "country_data = [\n",
    "    (1, \"USA\"),\n",
    "    (2, \"Canada\"),\n",
    "    (3, \"Brazil\"),\n",
    "    (4, \"UK\"),\n",
    "    (5, \"France\"),\n",
    "]\n",
    "\n",
    "# Create the DataFrame\n",
    "countries = spark.createDataFrame(country_data, schema=country_schema)\n",
    "\n",
    "# Create a temporary view for SQL queries\n",
    "countries.createOrReplaceTempView(\"countries\")\n",
    "\n",
    "# Show the table\n",
    "countries.show()\n",
    "\n",
    "# Example of joining with another table (assuming you have a customers table)\n",
    "# Using SQL\n",
    "spark.sql(\n",
    "    SELECT c.*, co.country ,\n",
    "    FROM customer c ,\n",
    "    JOIN countries co ON c.country_id = co.id\n",
    """).show()\n",
    "# Using DataFrame API\n",
    "customers.join(countries, customers.country_id == countries.id, \"inner\").show()"
   ]
  }
